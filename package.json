{
	"name": "@appartmint/css-mint",
	"author": "App Art Mint LLC",
	"version": "1.2.18",
	"type": "module",
	"license": "MIT",
	"description": "Styles by App Art Mint",
	"keywords": [
		"styles",
		"css",
		"sass",
		"scss",
		"app art mint",
		"appartmint"
	],
	"homepage": "https://github.com/App-Art-Mint/css-mint#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/App-Art-Mint/css-mint.git"
	},
	"bugs": {
		"url": "https://github.com/App-Art-Mint/css-mint/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src/**/*.scss",
		"dist/**/*.{css,map}"
	],
	"exports": {
		".": "./dist/index.css",
		"./*": "./dist/*.css",
		"scss/*": "./src/*.scss",
		"scss/*/": "./src/*/index.scss"
	},
	"scripts": {
		"version": "npm i && git add -A",
		"postversion": "git push && git push --tags && cross-replace gh release create \"v$npm_package_version\" --generate-notes",
		"prepare": "run-s build",
		"build": "run-p build:*",
		"build:dev": "sass src/index.scss dist/index.css",
		"build:prod": "sass src/index.scss dist/index.min.css --style compressed",
		"build:modules": "tsx scripts/build-modules.ts",
		"clean": "rimraf dist",
		"publish:link": "yalc publish",
		"check:updates": "npm-check-updates"
	},
	"devDependencies": {
		"@types/node": "^25.4.0",
		"cross-replace": "^0.2.0",
		"glob": "^13.0.6",
		"npm-check-updates": "^19.6.3",
		"npm-run-all2": "^8.0.4",
		"rimraf": "^6.1.3",
		"sass": "^1.97.3",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"yalc": "^1.0.0-pre.53"
	}
}
